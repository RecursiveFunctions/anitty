<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/schema/artifact-configuration/v1">
  <!--
    SignPath Foundation Artifact Configuration for Ghostty for Windows.
    Upload or import this file in SignPath -> Projects -> ghostty-windows -> Artifact Configurations:
    1. Slug "exe": for signing ghostty.exe before packaging the portable ZIP and Inno Setup installer.
    2. Slug "installer": for signing the compiled Inno Setup installer (ghostty-*-setup.exe).
  -->
  <zip-file>
    <pe-file path="ghostty.exe" />
    <pe-file path="ghostty-*-windows-x86_64-setup.exe" />
    <pe-file path="Ghostty-Windows-Setup-x64.exe" />
  </zip-file>
</artifact-configuration>
